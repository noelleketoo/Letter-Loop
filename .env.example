# --- Required ---------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Vercel Postgres, Railway...)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Public URL of the site, used in email links (no trailing slash)
APP_URL=https://your-app.vercel.app
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me-to-a-long-random-string

# --- Email: configure ONE of these --------------------------------------------
# Option A: Resend (https://resend.com) — needs a verified domain to email friends
RESEND_API_KEY=
# Option B: any SMTP server, e.g. Gmail with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
# "From" header for all emails
EMAIL_FROM="Blink Loop <you@gmail.com>"

# --- Photos -------------------------------------------------------------------
# Vercel Blob token (added automatically when you connect a Blob store on Vercel).
# Without it, photos are saved to the local disk (fine for local dev only).
BLOB_READ_WRITE_TOKEN=
